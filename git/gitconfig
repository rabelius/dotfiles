[core]
    excludesFile = ~/.gitignore_global
	pager = delta
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[alias]
    lg = log --oneline --graph --decorate --all
    st = status
    co = checkout
    br = branch
    ci = commit

[pull]
    rebase = true

[init]
    defaultBranch = main
[user]
	email = raabelius@gmail.com
	name = rabelius
[interactive]
	diffFilter = delta --color-only
